--[[
    @object-name: redbook
    @object-desc: Red Book (luci-app-redbook) for the GL.iNet admin panel.

    The panel only lets a logged-in administrator call these methods. They
    run /usr/bin/redbook without a shell (arguments are passed as a list)
    and read or write the "redbook" UCI settings. Every value is checked
    here before it is used or stored (gl-validator.d/redbook.lua turns the
    panel's own, much stricter check off for set_config, set_secret and
    get_lines). The backend checks every value again when it reads it.

    The panel's ngx.pipe gives a command arguments only (no stdin, no
    environment), and arguments are visible to every process, so the
    network folder's password never travels that way: set_secret writes it
    with UCI directly.

    The panel writes every call to the system log unless the method's name
    contains "get", "load" or "check"; hence get_status, get_lines and
    get_drives, which the pages call often.

    nginx keeps this module in memory once used: the package reloads nginx
    on install so a new version takes effect.

    SPDX-License-Identifier: MIT
--]]

local cjson = require "cjson"
local uci = require "uci"

local M = {}

local BIN = "/usr/bin/redbook"
local AUTH = "/etc/config/redbook_auth"

-- The panel's ngx.pipe is GL's own: spawn(args, opts), then
-- stdout_read_all() and wait(), nothing else.
local function spawn(cmd, seconds)
    local ms = (seconds or 30) * 1000
    local proc = ngx.pipe.spawn(cmd, { stdout_read_timeout = ms, wait_timeout = ms })
    if not proc then return "" end
    local out = proc:stdout_read_all()
    proc:wait()
    return out or ""
end

local function run(args, seconds)
    local cmd = { BIN }
    for _, a in ipairs(args) do cmd[#cmd + 1] = a end
    return spawn(cmd, seconds)
end

local function run_json(args, seconds)
    local ok, res = pcall(cjson.decode, run(args, seconds))
    if ok and type(res) == "table" then return res end
    return { err_code = -1, err_msg = "Red Book did not answer" }
end

local function int_arg(v, lo, hi, default)
    v = tonumber(v)
    if not v or v ~= v then return default end
    v = math.floor(v)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

-- "%.0f", not "%d": the panel's Lua may use 32-bit integers.
local function whole(n) return string.format("%.0f", n) end

local function text(max)
    return function(v) return #v <= max and not v:find("[%z\1-\31\127]") end
end

-- Log sources, in the order the pages show them. Keep in step with
-- SOURCES in the backend and common.js (tests/settings.test.js checks).
local SOURCES = { "system", "kernel", "crash", "boots", "health", "web", "mesh", "dns", "firewall", "conn" }
local LEVELED = { system = true, kernel = true, web = true, mesh = true }

--[[
    @method-name: get_status
    @method-desc: Storage, backup copy, sources and the router settings Red Book changes. Says whether a password is saved, never what it is.
--]]
M.get_status = function()
    return run_json({ "status" })
end

--[[
    @method-name: get_lines
    @method-desc: The last lines of a log source's newest day, optionally only those containing a text.
    @in string source  One of the log sources.
    @in number count   How many lines (1-500).
    @in string filter  Text to look for (optional).
--]]
M.get_lines = function(params)
    params = type(params) == "table" and params or {}
    local source = params.source
    local known = false
    for _, s in ipairs(SOURCES) do if s == source then known = true end end
    if not known then return { err_code = -1, err_msg = "unknown log source", field = "source" } end
    local filter = type(params.filter) == "string" and params.filter or ""
    if not text(64)(filter) then return { err_code = -1, err_msg = "invalid value", field = "filter" } end
    return run_json({ "lines", source, whole(int_arg(params.count, 1, 500, 100)), filter }, 60)
end

--[[
    @method-name: get_drives
    @method-desc: Mounted USB drives the logs could go to.
--]]
M.get_drives = function()
    return run_json({ "drives" })
end

--[[
    @method-name: flush
    @method-desc: Write what has been collected to the storage now (in the background).
--]]
M.flush = function()
    return run_json({ "flush-bg" })
end

--[[
    @method-name: test_network
    @method-desc: Mount the network folder with the saved settings and write a test file.
--]]
M.test_network = function()
    return run_json({ "test-network" }, 60)
end

--[[
    @method-name: install_support
    @method-desc: Install the packages a network folder needs, in the background.
    @in string type  smb or nfs.
--]]
M.install_support = function(params)
    local t = type(params) == "table" and params.type
    if t ~= "smb" and t ~= "nfs" then
        return { err_code = -1, err_msg = "invalid value", field = "type" }
    end
    return run_json({ "install-support", t })
end

-- ------------------------------------------------------------- settings --

local function range(lo, hi)
    return function(v)
        return v:match("^%d+$") ~= nil and #v <= 10 and tonumber(v) >= lo and tonumber(v) <= hi
    end
end

local function oneof(list)
    local set = {}
    for _, v in ipairs(list) do set[v] = true end
    return function(v) return set[v] == true end
end

local function flag(v) return v == "0" or v == "1" end

-- The same rules as the backend's safe_host, safe_path, safe_share, safe_rel.
local function host(v)
    return v:match("^[%w%.:%-]+$") ~= nil and v:sub(1, 1) ~= "-" and #v <= 253
end
local function abs_path(v)
    return v:match("^/[%w%._/%-]*$") ~= nil and not v:find("..", 1, true)
end
local function share(v)
    return v:match("^[%w%._/%$ %-]+$") ~= nil and v:sub(1, 1) ~= "-" and not v:find("..", 1, true) and #v <= 200
end
local function folder(v)
    return v:match("^[%w%._/ %-]+$") ~= nil and v:sub(1, 1) ~= "/" and not v:find("..", 1, true) and #v <= 200
end
local function user(v)
    return v:match("^[%w%._@%-]+$") ~= nil and v:sub(1, 1) ~= "-" and #v <= 64
end

-- Settings with a fixed set of values. Keep in step with the options in
-- common.js (tests/settings.test.js checks).
local CHOICES = {
    storage = { "usb", "network" },
    compress = { "gzip", "xz", "none" },
    flush_minutes = { "1", "5", "15" },
    net_type = { "smb", "nfs" },
    net_smbver = { "3.1.1", "3.0", "2.1", "2.0", "1.0" },
    syslog_proto = { "udp", "tcp" },
}
local LEVELS = { "emerg", "alert", "crit", "err", "warn", "notice", "info", "debug" }

-- Every setting the panel may change, with the check its value must pass.
-- Keep in step with the schema in common.js, which both settings pages are
-- drawn from (tests/settings.test.js checks).
local FIELDS = {
    enabled = { check = flag },
    storage = { check = oneof(CHOICES.storage) },
    usb_path = { optional = true, check = abs_path },
    backup = { check = flag },
    compress = { check = oneof(CHOICES.compress) },
    flush_minutes = { check = oneof(CHOICES.flush_minutes) },
    net_type = { check = oneof(CHOICES.net_type) },
    net_server = { optional = true, check = host },
    net_share = { optional = true, check = share },
    net_folder = { optional = true, check = folder },
    net_user = { optional = true, check = user },
    net_smbver = { optional = true, check = oneof(CHOICES.net_smbver) },
    syslog_send = { check = flag },
    syslog_server = { optional = true, check = host },
    syslog_port = { check = range(1, 65535) },
    syslog_proto = { check = oneof(CHOICES.syslog_proto) },
}
for _, s in ipairs(SOURCES) do
    FIELDS["src_" .. s] = { check = flag }
    FIELDS[s .. "_days"] = { check = range(1, 3650) }
    if LEVELED[s] then FIELDS[s .. "_level"] = { check = oneof(LEVELS) } end
end
M.FIELDS = FIELDS

--[[
    @method-name: get_config
    @method-desc: Current settings. The password is not among them.
--]]
M.get_config = function()
    local c = uci.cursor()
    local config = {}
    for key in pairs(FIELDS) do
        local v = c:get("redbook", "main", key)
        if type(v) == "string" then config[key] = v end
    end
    -- cjson writes an empty table as an array; the page copes with both.
    return { config = config }
end

--[[
    @method-name: set_config
    @method-desc: Check and store settings. Nothing is stored unless every value is valid.
    @in object values  setting -> value
--]]
M.set_config = function(params)
    local values = type(params) == "table" and params.values
    if type(values) ~= "table" then
        return { err_code = -1, err_msg = "no settings were sent" }
    end
    local changes = {}
    for key, v in pairs(values) do
        local field = type(key) == "string" and FIELDS[key]
        if not field then
            return { err_code = -1, err_msg = "unknown setting", field = tostring(key) }
        end
        if type(v) == "boolean" then
            v = v and "1" or "0"
        elseif type(v) == "number" then
            v = (v == math.floor(v)) and whole(v) or tostring(v)
        elseif type(v) ~= "string" then
            return { err_code = -1, err_msg = "invalid value", field = key }
        end
        v = v:match("^%s*(.-)%s*$")
        if v == "" then
            if not field.optional then
                return { err_code = -1, err_msg = "this setting cannot be empty", field = key }
            end
            changes[#changes + 1] = { key, false }
        elseif not field.check(v) then
            return { err_code = -1, err_msg = "invalid value", field = key }
        else
            changes[#changes + 1] = { key, v }
        end
    end
    local c = uci.cursor()
    if not c:get("redbook", "main") then c:set("redbook", "main", "redbook") end
    for _, ch in ipairs(changes) do
        if ch[2] == false then c:delete("redbook", "main", ch[1]) else c:set("redbook", "main", ch[1], ch[2]) end
    end
    c:commit("redbook")
    -- The daemon notices the change within half a minute and starts again.
    return { saved = true }
end

--[[
    @method-name: set_secret
    @method-desc: Store the network folder's password (root-only file). It cannot be read back.
    @in string secret
--]]
M.set_secret = function(params)
    local s = type(params) == "table" and params.secret
    if type(s) ~= "string" or s == "" then
        return { err_code = -1, err_msg = "no password was sent", field = "secret" }
    end
    if not text(128)(s) then
        return { err_code = -1, err_msg = "invalid value", field = "secret" }
    end
    -- The file must exist and be root only before the password goes in
    -- (UCI keeps a file's mode when it rewrites it).
    local f = io.open(AUTH, "a")
    if f then f:close() end
    spawn({ "/bin/chmod", "600", AUTH }, 10)
    local c = uci.cursor()
    if not c:get("redbook_auth", "main") then c:set("redbook_auth", "main", "auth") end
    c:set("redbook_auth", "main", "net_password", s)
    c:commit("redbook_auth")
    return { ok = true }
end

return M
