#!/bin/sh /etc/rc.common
# Red Book: collects the router's logs and writes them to the storage.
# shellcheck shell=dash disable=SC2034

START=99
STOP=10
USE_PROCD=1

# The instance always runs (it idles while disabled) and is restarted by
# procd whenever /etc/config/redbook changes, so new settings apply at once.
# On stop it writes what it has collected first, hence the long term_timeout.
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/redbook daemon
	procd_set_param file /etc/config/redbook
	procd_set_param respawn 3600 10 0
	procd_set_param term_timeout 30
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger redbook
}
