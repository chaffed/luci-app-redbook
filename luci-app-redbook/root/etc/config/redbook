
config redbook 'main'
	option enabled '1'
	option storage 'usb'
	option backup '0'
	option compress 'gzip'
	option flush_minutes '1'
	option net_type 'smb'
	option syslog_send '0'
	option syslog_port '514'
	option syslog_proto 'udp'
	option src_system '1'
	option system_level 'info'
	option system_days '90'
	option src_kernel '1'
	option kernel_level 'info'
	option kernel_days '90'
	option src_crash '1'
	option crash_days '365'
	option src_boots '1'
	option boots_days '365'
	option src_health '1'
	option health_days '90'
	option src_web '1'
	option web_level 'warn'
	option web_days '90'
	option src_mesh '0'
	option mesh_level 'warn'
	option mesh_days '30'
	option src_dns '0'
	option dns_days '30'
	option src_firewall '0'
	option firewall_days '30'
	option src_conn '0'
	option conn_days '30'
